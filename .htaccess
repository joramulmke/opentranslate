# OpenTranslate: app-specific security headers (this folder only; the rest of the site keeps its stricter policy).
#
# Why the site-wide defaults are relaxed here:
#   connect-src  https: + localhost  - translation providers are user-configured URLs (LibreTranslate, OpenAI-compatible
#                                      APIs, local Ollama/LM Studio); handwriting model files come from huggingface.co
#   script/worker-src cdn.jsdelivr.net + wasm-unsafe-eval - Tesseract.js (OCR), transformers.js (handwriting/speech models),
#                                      franc (language detection) and the on-device engine (vendor/bergamot, WebAssembly);
#                                      offline language models are downloaded from Mozilla's CDN (connect-src https:)
#   img/media blob: mediastream:     - camera preview and captured photos
#   Permissions-Policy camera/microphone=(self) - camera translation, voice input
# No upgrade-insecure-requests: it would rewrite http://localhost calls to local AI servers.

# The on-device translation engine: browsers only start WebAssembly served with this type (nosniff is on).
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self'; connect-src 'self' https: data: blob: http://localhost:* http://127.0.0.1:*; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  Header unset Permissions-Policy
  Header always unset Permissions-Policy
  Header always set Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=(), interest-cohort=()"
</IfModule>
