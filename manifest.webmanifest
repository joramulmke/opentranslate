{
  "name": "OpenTranslate",
  "short_name": "Translate",
  "description": "Translate text, photos, conversations and handwriting.",
  "id": "./",
  "start_url": "./#text",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf8ff",
  "theme_color": "#faf8ff",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshots/phone-text.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Translate text, with read aloud and saved phrases"
    },
    {
      "src": "icons/screenshots/phone-conversation.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Conversation: two people, two languages, one phone"
    },
    {
      "src": "icons/screenshots/phone-handwriting.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Handwriting: draw what you can't type"
    },
    {
      "src": "icons/screenshots/desktop-text.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "OpenTranslate on a computer"
    }
  ],
  "shortcuts": [
    {
      "name": "Camera",
      "short_name": "Camera",
      "description": "Translate text with the camera",
      "url": "./#camera",
      "icons": [
        {
          "src": "icons/shortcuts/camera.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Conversation",
      "short_name": "Conversation",
      "description": "Translate a conversation",
      "url": "./#conversation",
      "icons": [
        {
          "src": "icons/shortcuts/conversation.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Handwriting",
      "short_name": "Handwriting",
      "description": "Translate handwriting",
      "url": "./#handwriting",
      "icons": [
        {
          "src": "icons/shortcuts/handwriting.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Translate a file",
      "short_name": "File",
      "description": "Translate a file or website",
      "url": "./?open=docs",
      "icons": [
        {
          "src": "icons/shortcuts/file.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photo",
          "accept": [
            "image/*",
            "text/plain",
            ".txt",
            "application/pdf",
            ".pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            ".pptx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.oasis.opendocument.text",
            ".odt",
            "application/vnd.oasis.opendocument.spreadsheet",
            ".ods",
            "application/vnd.oasis.opendocument.presentation",
            ".odp",
            "application/epub+zip",
            ".epub",
            "text/html",
            ".html",
            ".htm",
            "text/markdown",
            ".md",
            "application/x-subrip",
            ".srt",
            "text/vtt",
            ".vtt",
            "text/csv",
            ".csv",
            "text/x-gettext-translation",
            ".po",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/avif": [
          ".avif"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ],
        "application/vnd.oasis.opendocument.presentation": [
          ".odp"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/markdown": [
          ".md"
        ],
        "application/x-subrip": [
          ".srt"
        ],
        "text/vtt": [
          ".vtt"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/x-gettext-translation": [
          ".po"
        ],
        "application/json": [
          ".json"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+translate",
      "url": "./?q=%s#text"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
