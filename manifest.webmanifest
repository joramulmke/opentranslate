{
  "name": "OpenTranslate",
  "short_name": "Translate",
  "description": "Translate text, photos, conversations and handwriting.",
  "id": "./",
  "start_url": "./#text",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf8ff",
  "theme_color": "#faf8ff",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshots/phone-text.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Translate text, with read aloud and saved phrases"
    },
    {
      "src": "icons/screenshots/phone-conversation.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Conversation: two people, two languages, one phone"
    },
    {
      "src": "icons/screenshots/phone-handwriting.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Handwriting: draw what you can't type"
    },
    {
      "src": "icons/screenshots/desktop-text.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "OpenTranslate on a computer"
    }
  ],
  "shortcuts": [
    {
      "name": "Camera",
      "url": "./#camera",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Conversation",
      "url": "./#conversation",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Handwriting",
      "url": "./#handwriting",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photo",
          "accept": [
            "image/*",
            "text/plain",
            ".txt",
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/avif": [
          ".avif"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+translate",
      "url": "./?q=%s#text"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
